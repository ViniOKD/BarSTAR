# isso aqui é um arquivo de exemplo de variáveis de ambiente para o projeto BarSTAR.
# crie um arquivo .env na raiz do projeto e copie o conteúdo deste arquivo para lá, preenchendo as variáveis de acordo com o seu ambiente de desenvolvimento.

# configuração do banco MySQL
MYSQL_DATABASE=barstar
MYSQL_USER=barstar
MYSQL_PASSWORD=dev_password
MYSQL_ROOT_PASSWORD=dev_root_password

# chave do Django para desenvolvimento local
DJANGO_SECRET_KEY=barstar-local-development-key

# ativa o modo dev
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

